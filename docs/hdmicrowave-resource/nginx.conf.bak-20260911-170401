		# 限制所有 location 的并发连接数
		limit_conn api_conn_zone 30;
		
		# 设置返回状态码
		limit_req_status 429;
		limit_conn_status 503;
		# =====================================
		
		# ========== 新增：OSS 代理转发规则（通用版）==========
		location ^~ /aliyunoss/ {
			# 重写路径：去掉 /aliyunoss 前缀
			rewrite ^/aliyunoss/(.*)$ /$1 break;
			
			# 代理转发到阿里云 OSS
			proxy_pass https://hd-china-web-site.oss-cn-hangzhou.aliyuncs.com;
			
			# 保留原始请求参数（Query String）
			# proxy_pass 会自动传递查询参数，无需额外配置
			
			# 设置代理请求头
			proxy_set_header Host hd-china-web-site.oss-cn-hangzhou.aliyuncs.com;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			
			# 可选：OSS 可能需要的一些头信息
			proxy_set_header Authorization "";
			
			# 缓冲区优化
			proxy_buffering on;
			proxy_buffer_size 4k;
			proxy_buffers 8 4k;
			
			# 控制重定向行为
			proxy_redirect off;
			
			# 支持大文件传输
			proxy_max_temp_file_size 0;
			
			# SSL 配置（如果使用 HTTPS）
			proxy_ssl_server_name on;
			proxy_ssl_protocols TLSv1.2 TLSv1.3;
		}
		# =====================================

                		# ========== 新增：RAG 资源转发 ==========
		# /api/v1/rag-assets/* → http://8.137.117.154:8001（完整 URI 原样透传）
		location ^~ /api/v1/rag-assets/ {
			# proxy_pass 后不带路径、不带尾部斜杠，nginx 会原样转发 /api/v1/rag-assets/...
			proxy_pass http://8.137.117.154:8001;

			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;

			proxy_connect_timeout 60s;
			proxy_send_timeout 60s;
			proxy_read_timeout 60s;
		}
		# =====================================

		location / {
			# ========== 限制下载速度 ==========
			limit_req zone=api_req_zone burst=50 nodelay;
			limit_rate 100k;           # 单连接100KB/s
			limit_rate_after 500k;     # 前1MB不限速，之后限速
			# ================================
			
			proxy_pass http://47.109.176.145:8080;
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
