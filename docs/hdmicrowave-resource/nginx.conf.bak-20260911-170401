    server {
		listen       443 ssl;
        server_name  xiaoda.hdmicrowave.com;
    
        ssl_certificate      xiaoda.hdmicrowave.com.pem;
        ssl_certificate_key  xiaoda.hdmicrowave.com.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  5m;

        ssl_ciphers  HIGH:!aNULL:!MD5;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers  on;
        client_max_body_size 100m;

        # ------------------------------
        # 放在这里，server 下所有 location 都生效
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ------------------------------
		
		# ========== 新增：全局限速配置 ==========
		# 限制所有 location 的并发连接数
		limit_conn api_conn_zone 30;
		
		# 设置返回状态码
		limit_req_status 429;
		limit_conn_status 503;
		# =====================================
		
		# ==================== Dify API 路由（优先级最高）====================
		
		# 1.1 Console API：/v2/console/api/* → 后端 /console/api/*
		location ^~ /v2/console/api/ {
		
		    # ========== 新增：限制请求频率 ==========
			limit_req zone=api_req_zone burst=30 nodelay;
			# =====================================
			
			# 关键：去掉 /v2 前缀，只保留 /console/api/
			rewrite ^/v2(/console/api/.*)$ $1 break;
			proxy_pass http://8.137.117.154:5001;
			
			# API 超时配置
			proxy_connect_timeout 300s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_buffering off;
			
			# 代理头
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
		
		location /dist/ {
			# 代理到Tomcat（假设Tomcat运行在8080端口）
			proxy_pass http://47.109.176.145:8085/dist/;
			
			# 如果Tomcat在其他服务器上，使用对应的IP:端口
			# proxy_pass http://tomcat-server-ip:8080/dist/;
		}
		
		# 1.2 WebApp API：/v2/api/* → 后端 /api/*
		location ^~ /v2/api/ {
			
			limit_req zone=api_req_zone burst=30 nodelay;  # 新增 
			
			# 关键：去掉 /v2 前缀，只保留 /api/
			rewrite ^/v2(/api/.*)$ $1 break;
			proxy_pass http://8.137.117.154:5001;
			
			# API 超时配置
			proxy_connect_timeout 300s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_buffering off;
			
			# 代理头
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
		
		# 1.2 WebApp API：/v2/v1/* → 后端 /v1/*
		location ^~ /v2/v1/ {
		
			limit_req zone=api_req_zone burst=20 nodelay;  # 新增（更严格）
			
			# 关键：去掉 /dify 前缀，只保留 /v1/
			rewrite ^/v2(/v1/.*)$ $1 break;
			proxy_pass http://8.137.117.154:5001;
			
			# API 超时配置
			proxy_connect_timeout 300s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_buffering off;
			
			# 代理头
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}

		# 1.3 Files API：/v2/files/* → 后端 /files/*
		location ^~ /v2/files/ {
			
			limit_req zone=api_req_zone burst=50 nodelay;  # 新增（文件上传可以宽松些）
			
			rewrite ^/v2(/files/.*)$ $1 break;
			proxy_pass http://8.137.117.154:5001;
			
			proxy_connect_timeout 300s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_buffering off;
		}
		
		# 1.4 Agent Chat API：/v2/agentchat → 后端 /api/v1/chat
		location ^~ /v2/agentchat {
		
			limit_req zone=api_req_zone burst=10 nodelay;  # 新增（聊天接口严格限制）
			
			# 直接转发到指定地址，不需要路径重写
			proxy_pass http://8.137.117.154:8001/api/v1/chat;
			
			# API 超时配置
			proxy_connect_timeout 300s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_buffering off;
			
			# 代理头
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}

                location ^~ /v3/agentchat {

                        limit_req zone=api_req_zone burst=10 nodelay;  # 新增（聊天接口严格限制）

                        # 直接转发到指定地址，不需要路径重写
                        proxy_pass http://8.137.117.154:8002/api/v1/chat;

                        # API 超时配置
                        proxy_connect_timeout 300s;
                        proxy_send_timeout 300s;
                        proxy_read_timeout 300s;
                        proxy_buffering off;

                        # 代理头
                        proxy_set_header Host $host;
                        proxy_set_header X-Real-IP $remote_addr;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        proxy_set_header X-Forwarded-Proto $scheme;
                }

                location ^~ /v4/agentchat {

                        limit_req zone=api_req_zone burst=10 nodelay;  # 新增（聊天接口严格限制）

                        # 直接转发到指定地址，不需要路径重写
                        proxy_pass http://8.137.117.154:8888/api/v1/chat;

                        # API 超时配置
                        proxy_connect_timeout 300s;
                        proxy_send_timeout 300s;
                        proxy_read_timeout 300s;
                        proxy_buffering off;

                        # 代理头
                        proxy_set_header Host $host;
                        proxy_set_header X-Real-IP $remote_addr;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        proxy_set_header X-Forwarded-Proto $scheme;
                }

                location ^~ /v2/douyinchat {

                        limit_req zone=api_req_zone burst=10 nodelay;  # 新增（聊天接口严格限制）

                        # 直接转发到指定地址，不需要路径重写
                        proxy_pass http://8.137.117.154:8001/api/v1/douyin/chat;
                        proxy_http_version 1.1;
                        proxy_pass_request_headers on;

                        # 明确保留外部 Authorization
                        proxy_set_header Authorization $http_authorization;
                        # API 超时配置
                        proxy_connect_timeout 300s;
                        proxy_send_timeout 300s;
                        proxy_read_timeout 300s;
                        proxy_buffering off;

                        # 代理头
                        proxy_set_header Host $host;
                        proxy_set_header X-Real-IP $remote_addr;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        proxy_set_header X-Forwarded-Proto $scheme;
                }

		# ==================== Dify 前端（Next.js）====================
		
		# 2. 所有其他 /dify/ 路径 → Next.js (3333)
		location ^~ /v2/ {
		
			# ========== 新增：前端页面可以宽松一些 ==========
			limit_req zone=api_req_zone burst=100 nodelay;
			# ============================================
	
			proxy_pass http://8.137.117.154:3333;
			
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection "upgrade";
			proxy_cache_bypass $http_upgrade;
			
			# WebSocket 支持
			proxy_read_timeout 86400;
		}
		
		# 3. 特殊路由：/chat/share 重定向
		#location = /chat/share {
		#	return 301 https://xiaoda.hdmicrowave.com/dify/chat/4ojNyAxGhMowuhxU;
		#}

		# ==================== 旧应用路由 ====================
    
		location / {
            root /usr/share/nginx/xiaoda;
            index xiaoda.html  index.html index.htm;
            try_files $uri $uri/ /xiaoda.html;
        }
		location /xd/ {
		    limit_req zone=api_req_zone burst=20 nodelay;  # 新增
			
            proxy_pass_request_headers on;
            proxy_pass http://8.137.117.154:8088;
        }
		location /chat/ {
		    limit_req zone=api_req_zone burst=30 nodelay;  # 新增
			
            proxy_pass http://8.137.117.154:3001;
        }
		location /_next/ {
            proxy_pass http://8.137.117.154:3001;
        }
        location /icon/ {
            proxy_pass http://8.137.117.154:3001;
        }
        location /js/ {
            proxy_pass http://8.137.117.154:3001;
        }
		location /imgs/ {
            proxy_pass http://8.137.117.154:3001;
        }
		location /generate {
			limit_req zone=api_req_zone burst=5 nodelay;   # 新增（AI生成接口严格限制）
			
            proxy_pass http://8.137.117.154:5000/generate;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
	
		location /productsinfo/ {
			limit_req zone=api_req_zone burst=20 nodelay;  # 新增
			
			proxy_pass http://8.137.117.154:9000/productsinfo/;
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
		}
	
		location /rag/api/ {
			limit_req zone=api_req_zone burst=10 nodelay;  # 新增（RAG接口严格）
			
			proxy_pass http://8.137.117.154:5005/api;
		}

		location /api/ {
			rewrite ^/ai/(.*)$ /$1 break;
			proxy_pass http://8.137.117.154:3001;
		}

		location /ai/ {
			rewrite ^/ai/(.*)$ /$1 break;
			proxy_pass http://8.137.117.154:3001;
		}
    }
    
