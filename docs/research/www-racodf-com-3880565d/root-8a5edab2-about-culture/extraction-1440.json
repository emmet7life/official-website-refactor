  "html": "<div id=\"about-culture\" class=\"about-part scroll-mt-20\">\n        <!-- 愿景 + 使命 -->\n        <div class=\"grid gap-5 lg:gap-6\">\n          <!-- 愿景 -->\n          <div class=\"fade-in-up flex flex-col rounded-xl border border-primary/15 bg-primary-light/50 p-8 lg:p-10 is-visible\">\n            <div class=\"flex items-center gap-3\">\n              <span class=\"flex items-center justify-center w-10 h-10 rounded-lg bg-primary-mid/20 text-primary-mid shrink-0\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></span>\n              <span class=\"text-sm font-semibold tracking-[0.15em] text-primary-mid\">愿景 VISION</span>\n            </div>\n            <p id=\"culture-vision\" class=\"mt-6 text-2xl md:text-3xl font-semibold leading-snug text-gray-900\">成为世界一流的传感、导航与数字系统高科技公司</p>\n          </div>\n          <!-- 使命（填写后才显示）-->\n          <div id=\"culture-mission-card\" class=\"fade-in-up is-visible flex flex-col rounded-xl border border-primary/15 bg-primary-light/50 p-8 lg:p-10\" style=\"display:none\">\n            <div class=\"flex items-center gap-3\">\n              <span class=\"flex items-center justify-center w-10 h-10 rounded-lg bg-primary-mid/20 text-primary-mid shrink-0\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z\"></path><path d=\"M4 22V15\"></path></svg></span>\n              <span class=\"text-sm font-semibold tracking-[0.15em] text-primary-mid\">使命 MISSION</span>\n            </div>\n            <p id=\"culture-mission\" class=\"mt-6 text-2xl md:text-3xl font-semibold leading-snug text-gray-900\"></p>\n          </div>\n        </div>\n\n        <!-- 价值观 -->\n        <div class=\"fade-in-up mt-12 lg:mt-16 is-visible\">\n          <div class